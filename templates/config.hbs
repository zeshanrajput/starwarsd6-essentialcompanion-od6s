{{!--

This is using an HTML template processor called Handlebars
https://handlebarsjs.com/guide/

--}}
<form id="swd6-config">
	<p>{{localize 'starwarsd6.form.desc'}}</p>

	<section>
		{{#each options}}
		<div class="form-group">
			<label for="swd6.{{id}}">{{localize desc}}</label>
			<input id="swd6.{{id}}" name="{{id}}" type="checkbox" {{#if on}}checked{{/if}} />
		</div>
		{{/each}}
	</section>
</form>
